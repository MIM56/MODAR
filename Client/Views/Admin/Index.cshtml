@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = "_AdminLayout";
}

<!-- Preconnect untuk performa lebih baik -->
<link rel="preconnect" href="https://cdnjs.cloudflare.com">
<link rel="dns-prefetch" href="https://cdnjs.cloudflare.com">

<!-- Chart.js dengan loading optimization -->
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js" defer></script>

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" media="print" onload="this.media='all'" />
<noscript>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
</noscript>


<link rel="stylesheet" href="~/css/admin-dashboard.css" />

<!-- HERO SECTION - PUTIH seperti Manager -->
<section class="hero-section">
    <div class="container">
        <div class="hero-content">
            <div class="hero-text">
                <h1 class="hero-title">Dashboard</h1>
                <p class="hero-subtitle">Welcome back, admin! Manage your system, employees, and projects efficiently.</p>
            </div>
             @* <a asp-controller="Login" asp-action="Logout" class="btn-sign-out">
                        <i class="fas fa-sign-out-alt"></i>
                        <span class="d-none d-sm-inline">Sign Out</span>
                    </a> *@
            <div class="hero-stats">
                <div class="mini-stat-card">
                    <div class="mini-stat-value" id="totalEmployees">0</div>
                    <div class="mini-stat-label">
                        <i class="fas fa-users"></i> Total Employees
                    </div>
                </div>
                <div class="mini-stat-card">
                    <div class="mini-stat-value" id="totalManagers">0</div>
                    <div class="mini-stat-label">
                        <i class="fas fa-user-tie"></i> Total Managers
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- MAIN CONTENT -->
<div class="container">
    <!-- Stats Cards -->
    <div class="stats-grid">
        <div class="stat-card">
            <div class="stat-card-header">
                <div class="stat-content">
                    <div class="stat-label">Number of Employees</div>
                    <div class="stat-value" id="statEmployees">0</div>
                    <div class="stat-change positive">
                        <i class="fas fa-arrow-up"></i> <span id="employeeGrowth">0%</span> this month
                    </div>
                </div>
                <div class="stat-icon primary">
                    <i class="fas fa-users"></i>
                </div>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-card-header">
                <div class="stat-content">
                    <div class="stat-label">Number of Managers</div>
                    <div class="stat-value" id="statManagers">0</div>
                    <div class="stat-change positive">
                        <i class="fas fa-check"></i> Active managers
                    </div>
                </div>
                <div class="stat-icon danger">
                    <i class="fas fa-user-tie"></i>
                </div>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-card-header">
                <div class="stat-content">
                    <div class="stat-label">Total Projects</div>
                    <div class="stat-value" id="statProjects">0</div>
                    <div class="stat-change positive">
                        <i class="fas fa-arrow-up"></i> <span id="projectGrowth">0%</span> this month
                    </div>
                </div>
                <div class="stat-icon success">
                    <i class="fas fa-folder"></i>
                </div>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-card-header">
                <div class="stat-content">
                    <div class="stat-label">Total Reports</div>
                    <div class="stat-value" id="statReports">0</div>
                    <div class="stat-change positive">
                        <i class="fas fa-arrow-up"></i> <span id="reportGrowth">0%</span> this month
                    </div>
                </div>
                <div class="stat-icon warning">
                    <i class="fas fa-file-alt"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Charts Section -->
    <div class="charts-grid">
        <div class="chart-card">
            <div class="chart-header">
                <h3 class="chart-title">
                    <i class="fas fa-chart-pie"></i>
                    User Distribution
                </h3>
            </div>
            <div class="chart-body" id="userDistributionChart"></div>
        </div>

        <div class="chart-card">
            <div class="chart-header">
                <h3 class="chart-title">
                    <i class="fas fa-chart-bar"></i>
                    Project Overview
                </h3>
            </div>
            <div class="chart-body" id="projectOverviewChart"></div>
        </div>
    </div>

    <!-- Recent Activity -->
    <div class="activity-section">
        <div class="activity-header">
            <h3 class="activity-title">
                <i class="fas fa-clock"></i>
                Recent Activity
            </h3>
            <a href="#" class="view-all-link">View All</a>
        </div>
        <div class="activity-table-wrapper">
            <table class="activity-table">
                <thead>
                    <tr>
                        <th>No</th>
                        <th>User</th>
                        <th>Role</th>
                        <th>Activity</th>
                        <th>Date</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody id="activityTableBody">
                    <tr>
                        <td colspan="6">
                            <div class="loading-state">
                                <div class="spinner-custom"></div>
                                <p>Loading activity...</p>
                            </div>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>
    <script src="~/js/admin-dashboard.js"></script>
}