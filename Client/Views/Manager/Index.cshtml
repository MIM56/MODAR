@{
    ViewData["Title"] = "Manager Dashboard";
    Layout = "_ManagerLayout";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<link rel="stylesheet" href="~/css/manager-dashboard.css" />

<!-- TOP NAVIGATION BAR -->
<nav class="top-navbar">
    <div class="navbar-container">
        <div class="navbar-left">
            <a href="@Url.Action("Index", "Manager")" class="navbar-brand">
                <i class="fas fa-rocket"></i>
                <span>MODAR</span>
            </a>
        </div>
        <div class="navbar-right">
            <a href="@Url.Action("Logout", "Manager")" class="btn-signout">
                <i class="fas fa-sign-out-alt"></i>
                <span>Sign Out</span>
            </a>
        </div>
    </div>
</nav>

<!-- HERO SECTION -->
<section class="hero-section">
    <div class="container">
        <div class="hero-content">
            <div class="hero-text">
                <h1 class="hero-title">Dashboard</h1>
                <p class="hero-subtitle">Welcome back, manager! Manage your team and projects efficiently.</p>
            </div>
            <div class="hero-stats">
                <div class="mini-stat-card">
                    <div class="mini-stat-value" id="totalProjects">0</div>
                    <div class="mini-stat-label">
                        <i class="fas fa-folder"></i> Total Projects
                    </div>
                </div>
                <div class="mini-stat-card">
                    <div class="mini-stat-value" id="totalReports">0</div>
                    <div class="mini-stat-label">
                        <i class="fas fa-file-alt"></i> Total Reports
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- MAIN CONTENT -->
<div class="container">
    <!-- Stats Cards -->
    <div class="stats-grid">
        <div class="stat-card">
            <div class="stat-card-header">
                <div class="stat-content">
                    <div class="stat-label">Number of Projects</div>
                    <div class="stat-value" id="statProjects">0</div>
                    <div class="stat-change positive">
                        <i class="fas fa-arrow-up"></i> <span id="projectGrowth">0%</span> this month
                    </div>
                </div>
                <div class="stat-icon primary">
                    <i class="fas fa-folder"></i>
                </div>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-card-header">
                <div class="stat-content">
                    <div class="stat-label">Number of Reports</div>
                    <div class="stat-value" id="statReports">0</div>
                    <div class="stat-change positive">
                        <i class="fas fa-arrow-up"></i> <span id="reportGrowth">0%</span> this month
                    </div>
                </div>
                <div class="stat-icon danger">
                    <i class="fas fa-file-alt"></i>
                </div>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-card-header">
                <div class="stat-content">
                    <div class="stat-label">Completed Projects</div>
                    <div class="stat-value" id="statCompleted">0</div>
                    <div class="stat-change positive">
                        <i class="fas fa-check"></i> <span id="successRate">0%</span> success rate
                    </div>
                </div>
                <div class="stat-icon success">
                    <i class="fas fa-check-circle"></i>
                </div>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-card-header">
                <div class="stat-content">
                    <div class="stat-label">Pending Reports</div>
                    <div class="stat-value" id="statPending">0</div>
                    <div class="stat-change negative">
                        <i class="fas fa-clock"></i> Need attention
                    </div>
                </div>
                <div class="stat-icon warning">
                    <i class="fas fa-exclamation-circle"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Charts Section -->
    <div class="charts-grid">
        <div class="chart-card">
            <div class="chart-header">
                <h3 class="chart-title">
                    <i class="fas fa-chart-pie"></i>
                    Report Status
                </h3>
            </div>
            <div class="chart-body" id="reportStatusChart"></div>
        </div>

        <div class="chart-card">
            <div class="chart-header">
                <h3 class="chart-title">
                    <i class="fas fa-chart-bar"></i>
                    Project Progress
                </h3>
            </div>
            <div class="chart-body" id="projectProgressChart"></div>
        </div>

        <div class="chart-card">
            <div class="chart-header">
                <h3 class="chart-title">
                    <i class="fas fa-chart-line"></i>
                    Monthly Activity
                </h3>
            </div>
            <div class="chart-body" id="monthlyActivityChart"></div>
        </div>

        <div class="chart-card">
            <div class="chart-header">
                <h3 class="chart-title">
                    <i class="fas fa-tasks"></i>
                    Task Overview
                </h3>
            </div>
            <div class="chart-body" id="taskOverviewChart"></div>
        </div>
    </div>
</div>

<!-- Scripts -->
@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>
    <script src="~/js/manager-dashboard.js"></script>
}