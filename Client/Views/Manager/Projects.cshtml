@{
    ViewData["Title"] = "Project List";
    Layout = "_ManagerLayout";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<link rel="stylesheet" href="~/css/manager-projects.css" />

<!-- HERO SECTION -->
<section class="hero-section">
    <div class="container">
        <div class="hero-content">
            <div class="hero-text">
                <h1 class="hero-title">Project List</h1>
                <p class="hero-subtitle">Manage and monitor all your projects in one place.</p>
            </div>
            <div class="hero-stats">
                <div class="stat-card">
                    <div class="stat-value" id="totalProjects">0</div>
                    <div class="stat-label">
                        <i class="fas fa-folder"></i> Total Projects
                    </div>
                </div>
                <div class="stat-card">
                    <div class="stat-value" id="activeProjects">0</div>
                    <div class="stat-label">
                        <i class="fas fa-check-circle"></i> Active
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- MAIN CONTENT -->
<div class="container">
    <!-- Action Bar -->
    <div class="action-bar">
        <button class="btn-create" id="createProjectBtn">
            <i class="fas fa-plus"></i> Create Project
        </button>
        <div class="action-bar-right">
            <div class="search-box">
                <i class="fas fa-search"></i>
                <input type="text" id="searchProjects" placeholder="Search projects...">
            </div>
            <select class="filter-select" id="filterStatus">
                <option value="">All Status</option>
                <option value="0">Pending</option>
                <option value="1">On Progress</option>
                <option value="2">Done</option>
            </select>
        </div>
    </div>

    <!-- Projects Table -->
    <div class="table-card">
        <div class="table-header">
            <h3 class="table-title">
                <i class="fas fa-list"></i> All Projects
            </h3>
            <div class="table-actions">
            <button class="btn-export" data-export="excel">
                <i class="fas fa-file-excel"></i> Excel
            </button>
            <button class="btn-export" data-export="pdf">
                <i class="fas fa-file-pdf"></i> PDF
            </button>
            <button class="btn-export" data-export="csv">
                <i class="fas fa-file-csv"></i> CSV
            </button>
          </div>
        </div>
        <div class="table-responsive">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>No</th>
                        <th>Title</th>
                        <th>Start Date</th>
                        <th>End Date</th>
                        <th>Status</th>
                        <th>Manager</th>
                        <th>Description</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody id="projectsTableBody">
                    <tr>
                        <td colspan="8">
                            <div class="loading-state">
                                <div class="spinner-custom"></div>
                                <p>Loading projects...</p>
                            </div>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- ========================================
     CREATE PROJECT MODAL
     ======================================== -->
<div class="modal fade" id="createProjectModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="fas fa-plus-circle me-2"></i> Create New Project
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="createProjectForm">
                    <div class="row">
                        <div class="col-12 mb-3">
                            <label class="form-label">Project Title <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="createTitle"
                                   required minlength="3" maxlength="50"
                                   placeholder="Enter project title (3-50 characters)">
                            <small class="char-counter text-muted" id="createTitleCounter">0/50 characters</small>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-12 mb-3">
                            <label class="form-label">Description <span class="text-danger">*</span></label>
                            <textarea class="form-control" id="createDescription" rows="3"
                                      required minlength="10" maxlength="255"
                                      placeholder="Enter project description (10-255 characters)"></textarea>
                            <small class="char-counter text-muted" id="createDescriptionCounter">0/255 characters</small>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Start Date <span class="text-danger">*</span></label>
                            <input type="date" class="form-control" id="createStartDate" required>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">End Date <span class="text-danger">*</span></label>
                            <input type="date" class="form-control" id="createEndDate" required>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Manager <span class="text-danger">*</span></label>
                            <select class="form-select" id="createManager" required>
                                <option value="">Select Manager</option>
                            </select>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Status <span class="text-danger">*</span></label>
                            <select class="form-select" id="createStatus" required>
                                <option value="0">Pending</option>
                                <option value="1">On Progress</option>
                                <option value="2">Done</option>
                            </select>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="fas fa-times me-2"></i>Cancel
                </button>
                <button type="button" class="btn btn-primary" onclick="submitCreateProject()">
                    <i class="fas fa-save me-2"></i>Create Project
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ========================================
     EDIT PROJECT MODAL
     ======================================== -->
<div class="modal fade" id="editProjectModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="fas fa-edit me-2"></i> Edit Project
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="editProjectForm">
                    <input type="hidden" id="editProjectId">
                    <div class="row">
                        <div class="col-12 mb-3">
                            <label class="form-label">Project Title <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="editTitle"
                                   required minlength="3" maxlength="50">
                            <small class="char-counter text-muted" id="editTitleCounter">0/50 characters</small>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-12 mb-3">
                            <label class="form-label">Description <span class="text-danger">*</span></label>
                            <textarea class="form-control" id="editDescription" rows="3"
                                      required minlength="10" maxlength="255"></textarea>
                            <small class="char-counter text-muted" id="editDescriptionCounter">0/255 characters</small>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Start Date <span class="text-danger">*</span></label>
                            <input type="date" class="form-control" id="editStartDate" required>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">End Date <span class="text-danger">*</span></label>
                            <input type="date" class="form-control" id="editEndDate" required>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Manager <span class="text-danger">*</span></label>
                            <select class="form-select" id="editManager" required>
                                <option value="">Select Manager</option>
                            </select>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Status <span class="text-danger">*</span></label>
                            <select class="form-select" id="editStatus" required>
                                <option value="0">Pending</option>
                                <option value="1">On Progress</option>
                                <option value="2">Done</option>
                            </select>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="fas fa-times me-2"></i>Cancel
                </button>
                <button type="button" class="btn btn-primary" onclick="submitEditProject()">
                    <i class="fas fa-save me-2"></i>Save Changes
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/manager-projects.js"></script>
}