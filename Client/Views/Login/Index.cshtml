@{
    ViewData["Title"] = "Sign In - MODAR";
    Layout = "";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script src="https://kit.fontawesome.com/64d58efce2.js" crossorigin="anonymous"></script>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Poppins:wght@200;300;400;500;600;700;800&display=swap">
    <link rel="stylesheet" href="/loginAssets/style.css" />
    <title>Sign In - MODAR</title>
</head>
<body>
    
    <!-- Tombol Back to Home - Pojok Kanan Atas -->
    <div class="back-home-container">
        <a href="/Home/Index" class="btn-back-home" id="btnBackHome">
            <i class="fas fa-home"></i>
            <span>Back to Home</span>
        </a>
    </div>

    <div class="container">
        <!-- Left Side - Illustration -->
        <div class="left-panel">
            <div class="content">
                <h3>Welcome to MODAR</h3>
                <p>Create your account to access our comprehensive project management system and streamline your daily workflow.</p>
                
                <button type="button" class="btn solid" onclick="window.location.href='/Login/Register'">
                    <i class="fas fa-user-plus"></i> Create Account
                </button>
            </div>
            <img src="/loginAssets/imgs/log.svg" class="image" alt="Login Illustration" onerror="this.style.display='none'" />
        </div>

        <!-- Right Side - Form -->
        <div class="forms-container">
            <div class="signin-signup">
                <form class="sign-in-form" id="formLogin">
                    <h2 class="title">Sign In</h2>
                    <div class="input-field">
                        <i class="fas fa-user"></i>
                        <input id="email" type="email" class="form-control" name="Email" placeholder="Email Address" required autocomplete="email" />
                    </div>
                    <div class="input-field">
                        <i class="fas fa-lock"></i>
                        <input id="password" type="password" name="Password" placeholder="Password" required autocomplete="current-password" />
                    </div>
                    
                    <button type="submit" class="btn solid" id="btnLogin">Sign In</button>
                    
                    <p class="text" style="margin-top: 15px; font-size: 13px; color: #666;">
                        <strong>Test Account:</strong><br>
                        Email: admin@modar.com | manager@modar.com | staff@modar.com<br>
                        Password: modar123
                    </p>
                </form>
            </div>
        </div>
    </div>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-MrcW6ZMFYlzcLA8Nl+NtUVF0sA7MsXsP1UyJoMp4YLEuNSfAP+JcXn/tWtIaxVXM"
        crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11.4.6/dist/sweetalert2.all.min.js"></script>

    <script>
        // ✅ FUNGSI UNTUK KEMBALI KE HOME
        function goToHome() {
            console.log("Navigating to Home...");
            window.location.href = '/Home/Index';
        }

        document.addEventListener('DOMContentLoaded', function() {
            // Event listener untuk tombol Back to Home
            const btnBackHome = document.getElementById('btnBackHome');
            if (btnBackHome) {
                btnBackHome.addEventListener('click', function(e) {
                    e.preventDefault();
                    goToHome();
                });
            }

            // Form login handler
            const formLogin = document.getElementById('formLogin');
            
            formLogin.addEventListener('submit', async function(event) {
                event.preventDefault();

                const emailInput = document.getElementById('email');
                const passwordInput = document.getElementById('password');
                const email = emailInput.value.trim();
                const password = passwordInput.value.trim();

                if (!email || !password) {
                    Swal.fire({
                        icon: 'warning',
                        title: 'Empty Fields',
                        text: 'Email and Password are required!',
                        confirmButtonColor: '#5995fd'
                    });
                    return;
                }

                const btn = document.getElementById('btnLogin');
                const originalText = btn.innerText;
                
                btn.innerText = "Loading...";
                btn.disabled = true;

                const apiUrl = "https://localhost:7261/api/Accounts/Login";

                try {
                    const response = await fetch(apiUrl, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'Accept': 'application/json'
                        },
                        body: JSON.stringify({
                            email: email,
                            password: password
                        })
                    });

                    const responseText = await response.text();
                    const trimmedText = responseText.trim();
                    const resultCode = parseInt(trimmedText);

                    if (resultCode === 2 || resultCode === 200) {
                        localStorage.setItem('userEmail', email);
                        localStorage.setItem('isLoggedIn', 'true');
                        localStorage.setItem('loginTime', new Date().toISOString());
                        
                        const expiryDate = new Date();
                        expiryDate.setDate(expiryDate.getDate() + 1);
                        document.cookie = `UserEmail=${encodeURIComponent(email)}; path=/; expires=${expiryDate.toUTCString()}; SameSite=Lax`;
                        document.cookie = `IsLoggedIn=true; path=/; expires=${expiryDate.toUTCString()}; SameSite=Lax`;

                        try {
                            const roleResponse = await fetch(`https://localhost:7261/api/Accounts/UserRoles?email=${encodeURIComponent(email)}`, {
                                method: 'GET',
                                headers: {
                                    'Accept': 'application/json'
                                }
                            });

                            let userRole = 'Employee';
                            
                            if (roleResponse.ok) {
                                const roleData = await roleResponse.json();
                                console.log("User roles:", roleData);
                                
                                if (Array.isArray(roleData) && roleData.length > 0) {
                                    userRole = roleData[0];
                                }
                            }

                            console.log("Final user role:", userRole);
                            localStorage.setItem('userRole', userRole);
                            document.cookie = `UserRole=${userRole}; path=/; expires=${expiryDate.toUTCString()}; SameSite=Lax`;

                            Swal.fire({
                                icon: 'success',
                                title: 'Login Successful!',
                                text: `Welcome as ${userRole}! Redirecting...`,
                                timer: 1500,
                                showConfirmButton: false,
                                confirmButtonColor: '#27ae60'
                            }).then(() => {
                                if (userRole.toLowerCase() === 'admin') {
                                    window.location.href = '/Admin/Index';
                                } else if (userRole.toLowerCase() === 'manager') {
                                    window.location.href = '/Manager/Index';
                                } else {
                                    window.location.href = '/Employees/Index';
                                }
                            });

                        } catch (roleError) {
                            console.error("Error fetching role:", roleError);
                            Swal.fire({
                                icon: 'success',
                                title: 'Login Successful!',
                                text: 'Redirecting...',
                                timer: 1500,
                                showConfirmButton: false
                            }).then(() => {
                                window.location.href = '/Employees/Index';
                            });
                        }

                    } else if (resultCode === 1 || resultCode === 401) {
                        Swal.fire({
                            icon: 'error',
                            title: 'Login Failed',
                            text: 'Password yang Anda masukkan salah!',
                            confirmButtonColor: '#e74c3c'
                        });
                    } else if (resultCode === 0 || resultCode === 404) {
                        Swal.fire({
                            icon: 'error',
                            title: 'Login Failed',
                            text: 'Email tidak terdaftar dalam sistem!',
                            confirmButtonColor: '#e74c3c'
                        });
                    } else {
                        Swal.fire({
                            icon: 'error',
                            title: 'Login Failed',
                            text: 'Response tidak valid dari server!',
                            confirmButtonColor: '#e74c3c'
                        });
                    }

                } catch (error) {
                    console.error("Error during login:", error);
                    Swal.fire({
                        icon: 'error',
                        title: 'Connection Failed',
                        text: 'Tidak bisa terhubung ke API. Pastikan API sudah berjalan.',
                        confirmButtonColor: '#e74c3c'
                    });
                } finally {
                    btn.innerText = originalText;
                    btn.disabled = false;
                }
            });
        });
    </script>
</body>
</html>