@{
    ViewData["Title"] = "Employee Dashboard";
    Layout = "_EmployeesLayout";
}


<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<link rel="stylesheet" href="~/css/employee-dashboard.css" />

<!-- HERO SECTION -->
<section class="hero-section">
    <div class="container">
        <div class="hero-content">
            <div class="hero-text">
                <h1 class="hero-title">Dashboard</h1>
                <p class="hero-subtitle">Welcome back! Manage your projects and track your daily progress.</p>
            </div>
            <div class="hero-stats">
                <div class="mini-stat-card">
                    <div class="mini-stat-value" id="totalProjects">0</div>
                    <div class="mini-stat-label"><i class="fas fa-folder"></i> Total Projects</div>
                </div>
                <div class="mini-stat-card">
                    <div class="mini-stat-value" id="totalReports">0</div>
                    <div class="mini-stat-label"><i class="fas fa-file-alt"></i> Total Reports</div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- MAIN CONTENT -->
<div class="container">
    <!-- Stats Cards -->
    <div class="stats-grid">
        <div class="stat-card">
            <div class="stat-card-header">
                <div class="stat-content">
                    <div class="stat-label">Number of Projects</div>
                    <div class="stat-value" id="statProjects">0</div>
                    <div class="stat-change positive"><i class="fas fa-arrow-up"></i> <span id="projectGrowth">0%</span> this month</div>
                </div>
                <div class="stat-icon primary"><i class="fas fa-folder"></i></div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-card-header">
                <div class="stat-content">
                    <div class="stat-label">Number of Reports</div>
                    <div class="stat-value" id="statReports">0</div>
                    <div class="stat-change positive"><i class="fas fa-arrow-up"></i> <span id="reportGrowth">0%</span> this month</div>
                </div>
                <div class="stat-icon danger"><i class="fas fa-file-alt"></i></div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-card-header">
                <div class="stat-content">
                    <div class="stat-label">Completed Projects</div>
                    <div class="stat-value" id="statCompleted">0</div>
                    <div class="stat-change positive"><i class="fas fa-check"></i> <span id="successRate">0%</span> success rate</div>
                </div>
                <div class="stat-icon success"><i class="fas fa-check-circle"></i></div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-card-header">
                <div class="stat-content">
                    <div class="stat-label">Pending Reports</div>
                    <div class="stat-value" id="statPending">0</div>
                    <div class="stat-change negative"><i class="fas fa-exclamation-circle"></i> Need attention</div>
                </div>
                <div class="stat-icon warning"><i class="fas fa-exclamation-triangle"></i></div>
            </div>
        </div>
    </div>

    <!-- Charts Section -->
    <div class="charts-grid">
        <div class="chart-card">
            <div class="chart-header">
                <h3 class="chart-title"><i class="fas fa-chart-pie"></i> Report Status</h3>
            </div>
            <div class="chart-body" id="reportStatusChart">
                <div class="loading-state">
                    <div class="spinner-custom"></div>
                    <p>Loading chart...</p>
                </div>
            </div>
        </div>
        <div class="chart-card">
            <div class="chart-header">
                <h3 class="chart-title"><i class="fas fa-chart-bar"></i> Project Progress</h3>
            </div>
            <div class="chart-body" id="projectProgressChart">
                <div class="loading-state">
                    <div class="spinner-custom"></div>
                    <p>Loading chart...</p>
                </div>
            </div>
        </div>
        <div class="chart-card">
            <div class="chart-header">
                <h3 class="chart-title"><i class="fas fa-chart-line"></i> Monthly Activity</h3>
            </div>
            <div class="chart-body" id="monthlyActivityChart">
                <div class="loading-state">
                    <div class="spinner-custom"></div>
                    <p>Loading chart...</p>
                </div>
            </div>
        </div>
    </div>
</div>


<!-- Chart.js CDN -->
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>

@section Scripts {
    <script src="~/js/employee-dashboard.js"></script>
}