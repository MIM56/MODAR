<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <link rel="apple-touch-icon" sizes="76x76" href="/assets/img/apple-icon.png">
    <link rel="icon" type="image/png" href="/adminAssets/img/favicon.png">
    <title>@ViewData["Title"] - MODAR</title>

    <!-- Fonts and icons -->
    <link href="https://fonts.googleapis.com/css?family=Open+Sans:300,400,600,700" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Nucleo Icons -->
    <link href="/adminAssets/css/nucleo-icons.css" rel="stylesheet" />
    <link href="/adminAssets/css/nucleo-svg.css" rel="stylesheet" />

    <!-- Font Awesome Icons -->
    <script src="https://kit.fontawesome.com/42d5adcbca.js" crossorigin="anonymous"></script>
    <link href="/adminAssets/css/nucleo-svg.css" rel="stylesheet" />

    <!-- CSS Files -->
    <link id="pagestyle" href="/adminAssets/css/argon-dashboard.css?v=2.0.4" rel="stylesheet" />
    <link rel="stylesheet" type="text/css" href="https://cdn.datatables.net/1.13.1/css/jquery.dataTables.css">

    <!-- Sweet Alert -->
    <script src="https://unpkg.com/sweetalert/dist/sweetalert.min.js"></script>

    <!-- Dark Mode CSS -->
    <style>
        /* ========================================
           DARK MODE STYLES
           ======================================== */
        body.dark-mode {
            background-color: #0f172a !important;
            color: #f1f5f9 !important;
        }

        body.dark-mode .main-content {
            background-color: #0f172a !important;
        }

        /* Sidebar */
        body.dark-mode .sidenav {
            background-color: #1e293b !important;
            border-color: #334155 !important;
        }

        body.dark-mode .sidenav .nav-link {
            color: #cbd5e1 !important;
        }

        body.dark-mode .sidenav .nav-link:hover,
        body.dark-mode .sidenav .nav-link.active {
            background-color: #334155 !important;
            color: #f1f5f9 !important;
        }

        body.dark-mode .sidenav .icon {
            color: #94a3b8 !important;
        }

        body.dark-mode .sidenav hr.horizontal.dark {
            background-image: linear-gradient(90deg, #334155, transparent) !important;
        }

        /* Navbar/Header */
        body.dark-mode .navbar-main,
        body.dark-mode .min-height-300.bg-primary {
            background: linear-gradient(135deg, #1e293b 0%, #334155 100%) !important;
        }

        body.dark-mode .navbar {
            background: linear-gradient(135deg, #1e293b 0%, #334155 100%) !important;
        }

        body.dark-mode .card,
        body.dark-mode .stat-card,
        body.dark-mode .chart-card {
            background-color: #1e293b !important;
            border-color: #334155 !important;
            color: #f1f5f9 !important;
        }

        body.dark-mode .stat-label,
        body.dark-mode .chart-title {
            color: #cbd5e1 !important;
        }

        body.dark-mode .stat-value {
            color: #f1f5f9 !important;
        }

        body.dark-mode .stat-change {
            color: #94a3b8 !important;
        }

        body.dark-mode .footer {
            background-color: #1e293b !important;
            color: #94a3b8 !important;
        }

        body.dark-mode .footer .copyright {
            color: #94a3b8 !important;
        }

        /* Hero Section */
        body.dark-mode .hero-section,
        body.dark-mode .bg-gradient-primary,
        body.dark-mode [class*="bg-gradient-"] {
            background: linear-gradient(135deg, #1e293b 0%, #334155 100%) !important;
        }

        body.dark-mode h1,
        body.dark-mode h2,
        body.dark-mode h3,
        body.dark-mode h4,
        body.dark-mode h5,
        body.dark-mode h6 {
            color: #f1f5f9 !important;
        }

        body.dark-mode .text-white {
            color: #f1f5f9 !important;
        }

        /* Icons and buttons */
        body.dark-mode .icon-box {
            background-color: #334155 !important;
        }

        body.dark-mode .btn-danger {
            background-color: #dc2626 !important;
            border-color: #dc2626 !important;
        }

        /* Charts */
        body.dark-mode .apexcharts-canvas text,
        body.dark-mode .apexcharts-canvas tspan {
            fill: #cbd5e1 !important;
        }

        /* Tables */
        body.dark-mode table {
            color: #f1f5f9 !important;
        }

        body.dark-mode thead {
            background-color: #334155 !important;
        }

        body.dark-mode tbody tr {
            border-color: #334155 !important;
        }

        /* Inputs */
        body.dark-mode input,
        body.dark-mode select,
        body.dark-mode textarea {
            background-color: #1e293b !important;
            border-color: #334155 !important;
            color: #f1f5f9 !important;
        }

        /* ========================================
           DARK MODE TOGGLE BUTTON
           ======================================== */
        .dark-mode-toggle {
            background: rgba(255, 255, 255, 0.2) !important;
            border: 2px solid rgba(255, 255, 255, 0.3) !important;
            color: white !important;
            width: 40px !important;
            height: 40px !important;
            border-radius: 50% !important;
            display: flex !important;
            align-items: center !important;
            justify-content: center !important;
            cursor: pointer !important;
            transition: all 0.3s ease !important;
            font-size: 18px !important;
            padding: 0 !important;
            margin: 0 10px 0 0 !important;
        }

        .dark-mode-toggle:hover {
            background: rgba(255, 255, 255, 0.3) !important;
            transform: rotate(180deg) !important;
        }

        body.dark-mode .dark-mode-toggle {
            background: rgba(255, 255, 255, 0.1) !important;
            border-color: rgba(255, 255, 255, 0.2) !important;
        }

        /* Icon Font Awesome */
        .dark-mode-toggle i {
            display: inline-block !important;
            color: #ffffff !important;
            font-size: 18px !important;
            line-height: 1 !important;
            visibility: visible !important;
            opacity: 1 !important;
        }

        body.dark-mode .dark-mode-toggle i {
            color: #fbbf24 !important;
        }

        /* Sign Out Button - ENSURE ALWAYS VISIBLE */
        .btn-sign-out {
            background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%) !important;
            color: white !important;
            border: none !important;
            padding: 10px 20px !important;
            border-radius: 8px !important;
            font-weight: 600 !important;
            font-size: 14px !important;
            cursor: pointer !important;
            transition: all 0.3s ease !important;
            display: inline-flex !important;
            align-items: center !important;
            gap: 8px !important;
            text-decoration: none !important;
            box-shadow: 0 4px 15px rgba(245, 87, 108, 0.3) !important;
        }

        .btn-sign-out:hover {
            transform: translateY(-2px) !important;
            box-shadow: 0 6px 20px rgba(245, 87, 108, 0.4) !important;
            color: white !important;
        }

        /* Hide breadcrumb */
        .breadcrumb {
            display: none !important;
        }

        /* Navbar alignment */
        #navbarBlur .container-fluid {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        #navbarBlur .navbar-nav {
            flex-direction: row !important;
            justify-content: flex-end !important;
            margin-left: auto !important;
        }

        #navbarBlur .nav-item {
            margin-left: 10px;
        }

        /* Fix for Argon Dashboard specific elements */
        body.dark-mode .bg-gradient-dark {
            background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%) !important;
        }

        body.dark-mode .card-stats .card-body {
            background-color: #1e293b !important;
        }

        body.dark-mode .progress {
            background-color: #334155 !important;
        }
    </style>
</head>

<body class="g-sidenav-show bg-gray-100">
    <div class="min-height-300 bg-primary position-absolute w-100"></div>
    <aside class="sidenav bg-white navbar navbar-vertical navbar-expand-xs border-0 border-radius-xl my-3 fixed-start ms-4 " id="sidenav-main">
        <div class="sidenav-header">
            <i class="fas fa-times p-3 cursor-pointer text-secondary opacity-5 position-absolute end-0 top-0 d-none d-xl-none" aria-hidden="true" id="iconSidenav"></i>
            <a class="navbar-brand m-0" href="@Url.Action("Index", "Employees")">
                <img src="/adminAssets/img/logo.png" class="navbar-brand-img h-100" alt="logo_modar" style="width:80%">
            </a>
        </div>
        <hr class="horizontal dark mt-0">
        <div class="collapse navbar-collapse w-auto" id="sidenav-collapse-main">
            <ul class="navbar-nav">
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Employees" asp-action="Index">
                        <div class="icon icon-shape icon-sm border-radius-md text-center me-2 d-flex align-items-center justify-content-center">
                            <i class="ni ni-tv-2 text-primary text-sm opacity-10"></i>
                        </div>
                        <span class="nav-link-text ms-1">Dashboard</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Employees" asp-action="Projects">
                        <div class="icon icon-shape icon-sm border-radius-md text-center me-2 d-flex align-items-center justify-content-center">
                            <i class="ni ni-calendar-grid-58 text-warning text-sm opacity-10"></i>
                        </div>
                        <span class="nav-link-text ms-1">Projects</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Employees" asp-action="Reports">
                        <div class="icon icon-shape icon-sm border-radius-md text-center me-2 d-flex align-items-center justify-content-center">
                            <i class="ni ni-calendar-grid-58 text-danger text-sm opacity-10"></i>
                        </div>
                        <span class="nav-link-text ms-1">Reports</span>
                    </a>
                </li>
            </ul>
        </div>
    </aside>

    <main class="main-content position-relative border-radius-lg">
        <!-- Navbar -->
        <nav class="navbar navbar-main navbar-expand-lg px-0 mx-4 shadow-none border-radius-xl" id="navbarBlur" data-scroll="false">
            <div class="container-fluid py-1 px-3">
                <nav aria-label="breadcrumb">
                    <h6 class="font-weight-bolder text-white mb-0">@ViewData["Title"]</h6>
                </nav>

                <!-- ✅ DARK MODE TOGGLE + SIGN OUT DI POJOK KANAN -->
                <div class="collapse navbar-collapse mt-sm-0 mt-2 me-md-0 me-sm-4" id="Logout">
                    <ul class="navbar-nav justify-content-end align-items-center">
                        <!-- Dark Mode Toggle Button -->
                        <li class="nav-item d-flex align-items-center">
                            <button class="dark-mode-toggle" id="darkModeToggle" title="Toggle Dark Mode">
                                <i class="fas fa-moon" id="darkModeIcon"></i>
                            </button>
                        </li>
                        <!-- Sign Out Button - ALWAYS VISIBLE -->
                        @* <li class="nav-item d-flex align-items-center">
                            <a asp-controller="Login" asp-action="Logout" class="btn-sign-out">
                                <i class="fas fa-sign-out-alt"></i>
                                <span>Sign Out</span>
                            </a>
                        </li> *@
                    </ul>
                </div>
            </div>
        </nav>
        <!-- End Navbar -->

        <div class="container-fluid py-4">
            @RenderBody()

            <footer class="footer pt-3">
                <div class="container-fluid">
                    <div class="row align-items-center justify-content-lg-between">
                        <div class="col-lg-6 mb-lg-0 mb-4">
                            <div class="copyright text-center text-sm text-muted text-lg-start">
                                ©
                                <script>document.write(new Date().getFullYear())</script>,
                                Modar
                            </div>
                        </div>
                    </div>
                </div>
            </footer>
        </div>
    </main>

    <!-- Core JS Files -->
    <script src="./assets/js/core/popper.min.js"></script>
    <script src="./assets/js/core/bootstrap.min.js"></script>
    <script src="./assets/js/plugins/perfect-scrollbar.min.js"></script>
    <script src="./assets/js/plugins/smooth-scrollbar.min.js"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="./adminAssets/js/argon-dashboard.min.js?v=2.0.4"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>

    <!-- DARK MODE TOGGLE SCRIPT -->
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const darkModeToggle = document.getElementById('darkModeToggle');
            const darkModeIcon = document.getElementById('darkModeIcon');
            const body = document.body;
            const savedDarkMode = localStorage.getItem('darkMode');

            console.log('🔍 Dark Mode Script Loaded');
            console.log('Toggle Button:', darkModeToggle);
            console.log('Icon Element:', darkModeIcon);

            if (savedDarkMode === 'enabled') {
                console.log('✅ Applying saved dark mode preference');
                body.classList.add('dark-mode');
                if (darkModeIcon) {
                    darkModeIcon.classList.remove('fa-moon');
                    darkModeIcon.classList.add('fa-sun');
                    console.log('✅ Icon changed to sun (fa-sun)');
                }
            } else {
                console.log('✅ Light mode is active');
                if (darkModeIcon) {
                    darkModeIcon.classList.remove('fa-sun');
                    darkModeIcon.classList.add('fa-moon');
                }
            }

            if (darkModeToggle) {
                darkModeToggle.addEventListener('click', function () {
                    console.log(' Toggle button clicked');
                    body.classList.toggle('dark-mode');

                    if (body.classList.contains('dark-mode')) {
                        console.log('🌙 Switching to DARK mode');
                        if (darkModeIcon) {
                            darkModeIcon.classList.remove('fa-moon');
                            darkModeIcon.classList.add('fa-sun');
                        }
                        localStorage.setItem('darkMode', 'enabled');
                    } else {
                        console.log('☀️ Switching to LIGHT mode');
                        if (darkModeIcon) {
                            darkModeIcon.classList.remove('fa-sun');
                            darkModeIcon.classList.add('fa-moon');
                        }
                        localStorage.setItem('darkMode', 'disabled');
                    }
                });
            } else {
                console.error('❌ Dark mode toggle button not found!');
            }
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>